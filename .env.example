# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public project URL + publishable key; never use service_role here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Stripe (mode test pendant le développement)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# E-mails (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="Vooruit Rijschool <info@vooruit.nl>"
# Adresse qui reçoit les demandes et notifications (par défaut: info@vooruit.nl)
EMAIL_TO=info@vooruit.nl

# Shared rate limiting and durable Stripe notification processing
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enable only after actual business details and package conditions are verified
BUSINESS_DETAILS_VERIFIED=false
STRIPE_LIVE_ENABLED=false
PACKAGE_PRICES_VERIFIED=false
